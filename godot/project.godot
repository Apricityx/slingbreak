; Independent Godot client. Gameplay and rendering are native GDScript.
config_version=5

[application]
config/name="弓引力 · SLING / BREAK"
config/version="0.0.6"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="res://assets/boot/splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/bg_color=Color(0.835294, 0.85098, 0.8, 1)
boot_splash/minimum_display_time=0

[display]
window/size/viewport_width=412
window/size/viewport_height=915
window/size/window_width_override=412
window/size/window_height_override=915
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/dpi/allow_hidpi=true
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_renderable_lights.web=4
limits/opengl/max_lights_per_object.web=4
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.835294, 0.85098, 0.8, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/mix_rate=44100
driver/output_latency=15
general/default_playback_type.web=1
