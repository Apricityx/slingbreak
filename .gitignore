# audio-diagnostics runtime exports (device logs, not source)
*.txt
*.log

# OpenChamber tooling artifacts (browser screenshots)
.openchamber/

# Compatibility browsers, profiles and visual test artifacts
agent-tmp/

# Generated benchmark reports, data and screenshots
/bench/results/

# Android build output and private release-signing material
/android/.gradle/
/android/**/build/
/android/local.properties
/android/signing.properties
/android/keystore/
*.jks
*.keystore

# Vendor X5 runtime input; not redistributed without permission.
/android/engine/*.apk
